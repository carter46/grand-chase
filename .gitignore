/node_modules
/public/hot
/public/storage
/storage/*.key
# /vendor is NOT ignored: committed for Hostinger/shared hosting (Composer often fails on server PHP mismatch).
# After dependency changes locally: composer install --no-dev --optimize-autoloader, then commit vendor/ + composer.lock

# Local secrets — never commit
.env
.env.*
!.env.example
.env.backup

.phpunit.result.cache
docker-compose.override.yml
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/.idea
/.vscode

# Runtime / generated
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Production SQL dumps contain PII and secrets — keep local/private; rotate credentials after any share
/database/u502532383_uscounty.sql
/database/*.dump.sql
/database/*_live.sql

# Static design reference HTML (not needed on Hostinger)
/new_fsm_trust_banking_website_frontpage/
