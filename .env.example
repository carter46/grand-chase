APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Public disk URL (root-relative; served via public/storage symlink)
FILESYSTEM_PUBLIC_URL=/storage

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Planned SaaS (membership/signals/copy-trade): keep false until product Active + merchant_key
FEATURE_SAAS_REMOTE_MODULES=false

# 7th Trade Hub — optional overrides (credentials live in Admin UI DB, not here)
# SEVENTH_TRADEHUB_HUB_URL=https://7th-tradehub.online
# Promote matching admins.email once when no platform super admin exists yet:
# SEVENTH_TRADEHUB_SUPER_ADMIN_EMAIL=you@example.com
# Hostinger / shared hosting: run every minute so owned poll runs every 10 minutes:
# * * * * * php /path/to/artisan schedule:run >> /dev/null 2>&1
# Platform SA seed (admin@demo.com) is applied via migration on next admin dashboard load.

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
